# Cloudflare Pages auto-detects a root-level 404.html for unmatched paths,
# but that only covers English routes. src/pages/jp/404.astro builds as
# /jp/404/index.html (Astro only special-cases the root 404.astro to emit a
# flat file), so without this rule an unmatched /jp/* path would silently
# fall back to the English 404 page instead of the Japanese one.
/jp/*  /jp/404/  404
