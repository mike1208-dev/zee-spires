---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { site } from "@/data/site";
import { services } from "@/data/services";
import { outcomes, clients, testimonials } from "@/data/content";

const inputCls =
  "w-full rounded-xl border border-border-soft bg-surface/60 px-4 py-3 text-fg placeholder:text-fg-subtle transition-colors focus:border-accent focus:outline-none";
const labelCls = "text-sm font-semibold text-fg";
---

<Layout
  title="Contact"
  description="Start a project with ZeeSpires. Send us a note, email us directly, or book a call — you'll talk straight to senior engineers."
>
  <section class="container-page pt-16 pb-20 md:pt-24 md:pb-28">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
      <!-- Title + contents, with contact details below -->
      <div class="flex flex-col">
        <h1 class="text-4xl font-medium leading-[1.05] tracking-tight sm:text-5xl md:text-6xl">
          Let's start a <span class="accent-italic">conversation.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-fg-muted">
          Tell us what you're trying to build. We'll get back within one
          business day — and you'll talk directly to the people who'd do the
          work.
        </p>

        <!-- Reach us directly -->
        <div class="mt-10">
          <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-hover">
            Reach us directly
          </h2>
          <ul class="mt-5 flex flex-col gap-4">
            <li>
              <a href={`mailto:${site.contact.email}`} class="flex items-start gap-3 text-sm text-fg-muted transition-colors hover:text-accent-hover">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent-hover"><Icon name="mail" size={18} /></span>
                <span><span class="block font-semibold text-fg">Email</span>{site.contact.email}</span>
              </a>
            </li>
            <li>
              <a href={`tel:${site.contact.phone.replace(/\s/g, "")}`} class="flex items-start gap-3 text-sm text-fg-muted transition-colors hover:text-accent-hover">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent-hover"><Icon name="phone" size={18} /></span>
                <span><span class="block font-semibold text-fg">Phone</span>{site.contact.phone}</span>
              </a>
            </li>
            <li class="flex items-start gap-3 text-sm text-fg-muted">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent-hover"><Icon name="pin" size={18} /></span>
              <span><span class="block font-semibold text-fg">Office</span>{site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}, {site.address.country}</span>
            </li>
          </ul>
        </div>

        <!-- Rather book a call -->
        <div class="card mt-8 flex flex-col gap-3 p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-soft text-accent-hover"><Icon name="calendar" size={20} /></span>
            <h2 class="text-base font-semibold">Rather book a call?</h2>
          </div>
          <p class="text-sm leading-relaxed text-fg-muted">Grab a 30-minute slot with a senior engineer. No sales script — just a real conversation about your project.</p>
          <div class="mt-1">
            <Button href={site.contact.bookingUrl} variant="secondary" external arrow>Book a call</Button>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="card p-6 sm:p-8">
        <form id="contact-form" class="flex flex-col gap-5" novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label class={labelCls} for="name">Name <span class="text-accent">*</span></label>
              <input class={inputCls} type="text" id="name" name="name" required autocomplete="name" placeholder="Jane Doe" />
            </div>
            <div class="flex flex-col gap-2">
              <label class={labelCls} for="email">Email <span class="text-accent">*</span></label>
              <input class={inputCls} type="email" id="email" name="email" required autocomplete="email" placeholder="jane@company.com" />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label class={labelCls} for="company">Company</label>
              <input class={inputCls} type="text" id="company" name="company" autocomplete="organization" placeholder="Acme Inc." />
            </div>
            <div class="flex flex-col gap-2">
              <label class={labelCls} for="service">What can we help with?</label>
              <select class={inputCls} id="service" name="service">
                <option value="">Select a service…</option>
                {services.map((s) => <option value={s.title}>{s.title}</option>)}
                <option value="Other">Something else</option>
              </select>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label class={labelCls} for="message">Message <span class="text-accent">*</span></label>
            <textarea class={`${inputCls} min-h-36 resize-y`} id="message" name="message" required placeholder="A few lines about your project, timeline, and goals…"></textarea>
          </div>

          <!-- Honeypot field for basic spam protection (hidden from users). -->
          <div class="absolute left-[-9999px]" aria-hidden="true">
            <label for="company_website">Leave this field empty</label>
            <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-center">
            <Button type="submit" size="lg" arrow class="sm:w-auto">
              <span data-submit-label>Send message</span>
            </Button>
            <p class="text-sm text-fg-subtle">
              Prefer email? <a class="font-medium text-accent hover:underline" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
            </p>
          </div>

          <!-- Status region (announced to screen readers). -->
          <p
            id="form-status"
            role="status"
            aria-live="polite"
            class="hidden rounded-xl px-4 py-3 text-sm font-medium"
          ></p>
        </form>
      </div>
    </div>
  </section>

  <!-- What to expect -->
  <section class="border-t border-border bg-bg-2">
    <div class="container-page py-20 md:py-28">
      <SectionHeader
        align="center"
        class="mx-auto"
        title={`What working with us <span class="accent-italic">looks like.</span>`}
        description="Senior-led, direct, and accountable — here's what you can count on."
      />
      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          outcomes.map((o) => (
            <div class="card flex items-center gap-4 p-6">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent-hover">
                <Icon name={o.icon} size={22} />
              </span>
              <p class="text-[0.98rem] font-medium leading-snug text-fg">{o.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Trusted by (placeholder logos) -->
  <section class="bg-bg-2 py-16">
    <div class="marquee-mask container-page flex overflow-hidden">
      <div class="marquee flex shrink-0 items-center gap-14 pr-14">
        {
          [...clients, ...clients].map((c) => (
            <span
              class="whitespace-nowrap text-xl font-semibold text-fg-muted/70"
              style="font-family: var(--font-display)"
            >
              {c}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="border-t border-border bg-bg-2">
    <div class="container-page py-20 md:py-28">
      <SectionHeader
        align="center"
        class="mx-auto"
        title={`In our clients' <span class="accent-italic">own words.</span>`}
      />
      <div class="mt-14 grid gap-5 md:grid-cols-3">
        {
          testimonials.map((t) => (
            <figure class="card flex flex-col gap-5 p-7">
              <blockquote class="text-[0.98rem] leading-relaxed text-fg">
                “{t.quote}”
              </blockquote>
              <figcaption class="mt-auto flex items-center gap-3 border-t border-border-soft pt-5">
                <img
                  src={t.avatar}
                  alt={t.name}
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                  class="h-11 w-11 shrink-0 rounded-full object-cover"
                />
                <span class="flex flex-col">
                  <span class="text-sm font-semibold text-fg">{t.name}</span>
                  <span class="text-xs text-fg-subtle">{t.role}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="mt-8 text-center text-xs text-fg-subtle">
        Representative testimonials shown for layout; real, attributed quotes
        added with client permission.
      </p>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const label = form?.querySelector<HTMLElement>("[data-submit-label]");

  const show = (msg: string, ok: boolean) => {
    if (!status) return;
    status.textContent = msg;
    status.classList.remove("hidden");
    status.style.background = ok
      ? "color-mix(in srgb, var(--accent) 12%, transparent)"
      : "color-mix(in srgb, #ef4444 12%, transparent)";
    status.style.color = ok ? "var(--accent)" : "#dc2626";
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = Object.fromEntries(new FormData(form).entries());
    if (submitBtn) submitBtn.disabled = true;
    if (label) label.textContent = "Sending…";

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const body = await res.json().catch(() => ({}));
      if (res.ok) {
        form.reset();
        show(
          "Thanks — your message is on its way. We'll be in touch within one business day.",
          true
        );
        if (label) label.textContent = "Message sent";
      } else {
        show(
          (body && body.error) ||
            "Something went wrong. Please email us at admin@zeespires.com.",
          false
        );
        if (submitBtn) submitBtn.disabled = false;
        if (label) label.textContent = "Send message";
      }
    } catch {
      show(
        "Network error. Please email us directly at admin@zeespires.com.",
        false
      );
      if (submitBtn) submitBtn.disabled = false;
      if (label) label.textContent = "Send message";
    }
  });
</script>
