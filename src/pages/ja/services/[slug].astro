---
import Layout from "@/layouts/Layout.astro";
import ServiceDetailContent from "@/components/ServiceDetailContent.astro";
import { services } from "@/data/services";
import { resolveLocale } from "@/i18n/utils";
import { localizeService } from "@/i18n/translations";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const lang = resolveLocale(Astro.currentLocale);
const s = localizeService(service, lang);
---

<Layout title={s.title} description={s.summary} theme="light">
  <ServiceDetailContent service={service} />
</Layout>
