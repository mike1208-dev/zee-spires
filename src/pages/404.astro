---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
---

<Layout title="Page not found" noindex>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="text-7xl font-bold text-accent sm:text-8xl">404</p>
    <h1 class="mt-4 text-2xl font-bold sm:text-3xl">
      This page reached a little <span class="accent-italic text-accent">too high.</span>
    </h1>
    <p class="mt-3 max-w-md text-fg-muted">
      The page you're looking for doesn't exist or has moved. Let's get you back
      on track.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <Button href="/" size="lg" arrow>Back home</Button>
      <Button href="/contact/" variant="secondary" size="lg">Contact us</Button>
    </div>
  </section>
</Layout>
