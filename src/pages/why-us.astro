---
import Layout from "@/layouts/Layout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaBand from "@/components/CtaBand.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import { differentiators, stats } from "@/data/content";
---

<Layout
  title="Why Us"
  description="Why work with ZeeSpires: senior-led teams, direct access to the builders, a U.S. registered LLC, and engineers with backgrounds at leading companies."
>
  <!-- Header -->
  <section class="relative overflow-hidden border-b border-border">
    <div class="bg-grid pointer-events-none absolute inset-0"></div>
    <div class="container-page relative py-16 md:py-24">
      <SectionHeader
        eyebrow="Why ZeeSpires"
        title='Grounded work, <span class="accent-italic text-accent">real accountability</span>'
        description="We keep things simple: senior engineers, direct communication, and honest trade-offs. Here's what that looks like in practice."
      />
    </div>
  </section>

  <!-- Stats band -->
  <section class="border-b border-border bg-surface">
    <div class="container-page py-12">
      <div class="grid grid-cols-2 gap-8 lg:grid-cols-4">
        {
          stats.map((s) => (
            <div class="reveal flex flex-col gap-1 text-center">
              <span class="text-4xl font-bold text-accent">{s.value}</span>
              <span class="text-sm text-fg-muted">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Differentiators -->
  <section class="container-page py-16 md:py-24">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        differentiators.map((d, i) => (
          <div
            class="reveal flex flex-col gap-3 rounded-2xl border border-border bg-surface p-7"
            data-delay={(i % 3) * 70}
          >
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-soft text-accent">
              <Icon name={d.icon} size={22} />
            </div>
            <h2 class="text-lg font-bold">{d.title}</h2>
            <p class="text-sm leading-relaxed text-fg-muted">{d.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Narrative / statement -->
  <section class="border-t border-border bg-surface">
    <div class="container-page py-16 md:py-24">
      <div class="mx-auto max-w-3xl text-center">
        <p
          class="reveal text-2xl font-medium leading-relaxed text-fg sm:text-3xl"
        >
          “We'd rather under-promise and ship than oversell and slip. Every
          engagement is led by someone who has
          <span class="accent-italic text-accent">actually built</span> and run
          the kind of system you need.”
        </p>
        <div class="reveal mt-8">
          <Button href="/team/" variant="secondary" arrow>Meet the team</Button>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
