---
import Layout from "@/layouts/Layout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaBand from "@/components/CtaBand.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import { services } from "@/data/services";
---

<Layout
  title="Services"
  description="AI Agent Development, Data Engineering, Full-Stack Development, and IT Consulting & Staffing — delivered by senior engineers, end to end."
>
  <!-- Page header -->
  <section class="relative overflow-hidden border-b border-border">
    <div class="bg-grid pointer-events-none absolute inset-0"></div>
    <div class="container-page relative py-16 md:py-24">
      <SectionHeader
        eyebrow="Services"
        title='What we build, <span class="accent-italic text-accent">end to end</span>'
        description="Four core disciplines. Each is senior-led and delivered with tests, documentation, and a team that stays accountable after launch."
      />
      <nav class="mt-10 flex flex-wrap gap-2" aria-label="Services">
        {
          services.map((s) => (
            <a
              href={`#${s.slug}`}
              class="rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium text-fg-muted transition-colors hover:border-accent hover:text-accent"
            >
              {s.title}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- Service detail sections -->
  {
    services.map((s, i) => (
      <section
        id={s.slug}
        class="scroll-mt-24 border-b border-border last:border-0"
        class:list={[i % 2 === 1 && "bg-surface"]}
      >
        <div class="container-page py-16 md:py-24">
          <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
            <div class="reveal flex flex-col gap-5">
              <div class="flex items-center gap-4">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-soft text-accent">
                  <Icon name={s.icon} size={28} />
                </div>
                <span class="text-sm font-semibold uppercase tracking-[0.14em] text-fg-subtle">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </div>
              <h2 class="text-3xl font-bold sm:text-4xl">{s.title}</h2>
              <p class="text-lg font-medium text-accent">{s.tagline}</p>
              <p class="text-lg leading-relaxed text-fg-muted">
                {s.description}
              </p>
              <div class="flex flex-wrap gap-2 pt-1">
                {s.stack.map((tech) => (
                  <span class="rounded-full border border-border bg-bg px-3 py-1.5 text-xs font-medium text-fg-muted">
                    {tech}
                  </span>
                ))}
              </div>
              <div class="pt-3">
                <Button href="/contact/" arrow>
                  Discuss a {s.title.toLowerCase()} project
                </Button>
              </div>
            </div>

            <div class="reveal" data-delay="100">
              <div class="rounded-2xl border border-border bg-bg p-7 md:p-9">
                <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-fg-subtle">
                  What you get
                </h3>
                <ul class="mt-6 flex flex-col gap-4">
                  {s.capabilities.map((cap) => (
                    <li class="flex items-start gap-3">
                      <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
                        <Icon name="check" size={15} />
                      </span>
                      <span class="text-[0.98rem] leading-relaxed text-fg">
                        {cap}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <CtaBand />
</Layout>
