---
/**
 * Hero illustration — an elegant skyline of "spires" rising to a central peak
 * with a beacon, drawn in gold line-art over a faint grid, with orbit arcs and
 * a soft glow. Pure SVG, theme-aware via currentColor, animated on load.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={`relative ${className}`}>
  <div
    class="glow-gold pointer-events-none absolute inset-0 -z-10 scale-125 opacity-70"
  >
  </div>
  <svg
    viewBox="0 0 440 400"
    fill="none"
    class="w-full text-accent"
    role="img"
    aria-label="Abstract skyline of spires rising to a peak"
  >
    <defs>
      <linearGradient id="spire-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="currentColor" stop-opacity="0.9" />
        <stop offset="1" stop-color="currentColor" stop-opacity="0.15" />
      </linearGradient>
      <linearGradient id="spire-stroke" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="currentColor" stop-opacity="1" />
        <stop offset="1" stop-color="currentColor" stop-opacity="0.3" />
      </linearGradient>
    </defs>

    <!-- faint grid -->
    <g stroke="currentColor" stroke-opacity="0.1" stroke-width="1">
      {Array.from({ length: 7 }).map((_, i) => (
        <line x1={40 + i * 60} y1="40" x2={40 + i * 60} y2="330" />
      ))}
      {Array.from({ length: 5 }).map((_, i) => (
        <line x1="40" y1={70 + i * 60} x2="400" y2={70 + i * 60} />
      ))}
    </g>

    <!-- orbit arcs -->
    <g stroke="currentColor" fill="none" stroke-opacity="0.35" stroke-width="1.5">
      <ellipse cx="220" cy="150" rx="150" ry="52" class="orbit orbit-1" />
      <ellipse cx="220" cy="150" rx="105" ry="34" stroke-opacity="0.25" class="orbit orbit-2" />
    </g>

    <!-- baseline -->
    <line x1="40" y1="330" x2="400" y2="330" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.5" />

    <!-- skyline spires -->
    <g>
      <!-- outer left -->
      <g class="spire" style="--d:.35s">
        <rect x="70" y="235" width="26" height="95" fill="url(#spire-fill)" />
        <rect x="70" y="235" width="26" height="95" stroke="url(#spire-stroke)" stroke-width="1.5" />
      </g>
      <!-- inner left -->
      <g class="spire" style="--d:.2s">
        <rect x="118" y="180" width="30" height="150" fill="url(#spire-fill)" />
        <rect x="118" y="180" width="30" height="150" stroke="url(#spire-stroke)" stroke-width="1.5" />
      </g>
      <!-- central spire -->
      <g class="spire" style="--d:0s">
        <path d="M190 118 L220 58 L250 118 Z" fill="url(#spire-fill)" stroke="url(#spire-stroke)" stroke-width="1.5" stroke-linejoin="round" />
        <rect x="192" y="116" width="56" height="214" fill="url(#spire-fill)" />
        <rect x="192" y="116" width="56" height="214" stroke="url(#spire-stroke)" stroke-width="1.5" />
        <circle cx="220" cy="58" r="4.5" fill="currentColor" class="beacon" />
        <circle cx="220" cy="58" r="10" fill="none" stroke="currentColor" stroke-opacity="0.5" class="beacon-ring" />
      </g>
      <!-- inner right -->
      <g class="spire" style="--d:.2s">
        <rect x="292" y="180" width="30" height="150" fill="url(#spire-fill)" />
        <rect x="292" y="180" width="30" height="150" stroke="url(#spire-stroke)" stroke-width="1.5" />
      </g>
      <!-- outer right -->
      <g class="spire" style="--d:.35s">
        <rect x="344" y="235" width="26" height="95" fill="url(#spire-fill)" />
        <rect x="344" y="235" width="26" height="95" stroke="url(#spire-stroke)" stroke-width="1.5" />
      </g>
    </g>

    <!-- window dots on central spire -->
    <g fill="currentColor" fill-opacity="0.55">
      {Array.from({ length: 8 }).map((_, r) =>
        Array.from({ length: 3 }).map((__, c) => (
          <rect x={202 + c * 15} y={138 + r * 22} width="4" height="4" rx="1" />
        ))
      )}
    </g>
  </svg>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .spire {
      transform-box: fill-box;
      transform-origin: bottom;
      animation: rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--d, 0s);
    }
    @keyframes rise {
      from {
        transform: scaleY(0);
        opacity: 0;
      }
      to {
        transform: scaleY(1);
        opacity: 1;
      }
    }
    .orbit {
      stroke-dasharray: 1000;
      stroke-dashoffset: 1000;
      animation: draw 2s ease-out 0.4s forwards;
    }
    .orbit-2 {
      animation-delay: 0.7s;
    }
    @keyframes draw {
      to {
        stroke-dashoffset: 0;
      }
    }
    .beacon {
      animation: pulse 2.4s ease-in-out infinite;
    }
    .beacon-ring {
      transform-box: fill-box;
      transform-origin: center;
      animation: ring 2.4s ease-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    @keyframes ring {
      0% { transform: scale(0.6); opacity: 0.7; }
      70%, 100% { transform: scale(1.8); opacity: 0; }
    }
  }
</style>
