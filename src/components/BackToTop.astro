---
/**
 * Floating "back to top" button. Appears after scrolling down; smooth-scrolls
 * to the top. Themed with the accent color; works on light and dark pages.
 */
---

<button
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  class="fixed bottom-6 right-6 z-40 flex h-12 w-12 translate-y-4 items-center justify-center rounded-full bg-accent text-accent-fg opacity-0 shadow-[var(--shadow-glow)] transition-all duration-300 hover:bg-accent-hover hover:-translate-y-0.5 pointer-events-none"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M6 11l6-6 6 6"></path>
  </svg>
</button>

<script>
  const btn = document.getElementById("back-to-top");
  const onScroll = () => {
    const show = window.scrollY > 500;
    btn?.classList.toggle("opacity-0", !show);
    btn?.classList.toggle("translate-y-4", !show);
    btn?.classList.toggle("pointer-events-none", !show);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
  btn?.addEventListener("click", () =>
    window.scrollTo({ top: 0, behavior: "smooth" })
  );
</script>
