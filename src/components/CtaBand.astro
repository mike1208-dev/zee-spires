---
import { site } from "@/data/site";
import Button from "./Button.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Let\'s build something <span class="accent-italic">higher.</span>',
  description = "Tell us what you're trying to build. You'll talk directly to senior engineers — no account managers, no runaround.",
} = Astro.props;
---

<section class="container-page py-24 md:py-32">
  <div
    class="card reveal relative overflow-hidden px-6 py-16 text-center sm:px-12 md:py-24"
  >
    <div class="bg-dots pointer-events-none absolute inset-0 opacity-60"></div>
    <div
      class="glow pointer-events-none absolute left-1/2 top-1/2 h-[120%] w-[70%] -translate-x-1/2 -translate-y-1/2 opacity-40"
    >
    </div>
    <div class="relative mx-auto flex max-w-2xl flex-col items-center gap-6">
      <h2 class="text-4xl font-medium leading-tight tracking-tight sm:text-5xl">
        <Fragment set:html={title} />
      </h2>
      <p class="text-lg text-fg-muted">{description}</p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href="/contact/" size="lg" arrow>Start a project</Button>
        <Button href={`mailto:${site.contact.email}`} variant="secondary" size="lg">
          Email us
        </Button>
      </div>
    </div>
  </div>
</section>
