---
import { site } from "@/data/site";
import { services } from "@/data/services";

/**
 * Organization + ProfessionalService structured data. Rendered site-wide so
 * search engines and social platforms understand the company correctly.
 */
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.url}/#organization`,
      name: site.legalName,
      alternateName: site.name,
      url: site.url,
      description: site.shortDescription,
      email: site.contact.email,
      telephone: site.contact.phone,
      logo: `${site.url}/favicon.svg`,
      address: {
        "@type": "PostalAddress",
        streetAddress: site.address.street,
        addressLocality: site.address.city,
        addressRegion: site.address.region,
        postalCode: site.address.postalCode,
        addressCountry: site.address.countryCode,
      },
      sameAs: [site.social.linkedin, site.social.github, site.social.x],
    },
    {
      "@type": "ProfessionalService",
      "@id": `${site.url}/#service`,
      name: site.legalName,
      image: `${site.url}/og-image.svg`,
      url: site.url,
      description: site.shortDescription,
      priceRange: "$$$",
      telephone: site.contact.phone,
      email: site.contact.email,
      address: {
        "@type": "PostalAddress",
        streetAddress: site.address.street,
        addressLocality: site.address.city,
        addressRegion: site.address.region,
        postalCode: site.address.postalCode,
        addressCountry: site.address.countryCode,
      },
      areaServed: "Worldwide",
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Services",
        itemListElement: services.map((s) => ({
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: s.title,
            description: s.summary,
            url: `${site.url}/services/${s.slug}/`,
          },
        })),
      },
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: site.url,
      name: site.name,
      publisher: { "@id": `${site.url}/#organization` },
      inLanguage: "en-US",
    },
  ],
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(graph)}
/>
