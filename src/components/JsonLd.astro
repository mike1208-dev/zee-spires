---
import { site } from "@/data/site";
import { services } from "@/data/services";
import { ogLocales } from "@/i18n/config";
import { resolveLocale, useTranslations, localizeHref } from "@/i18n/utils";
import { localizeService } from "@/i18n/translations";

/**
 * Organization + ProfessionalService structured data. Rendered site-wide so
 * search engines and social platforms understand the company correctly.
 */
const lang = resolveLocale(Astro.currentLocale);
const t = useTranslations(lang);
const description = t("meta.description");
const inLanguage = ogLocales[lang].replace("_", "-");

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.url}/#organization`,
      name: site.legalName,
      alternateName: site.name,
      url: site.url,
      description,
      email: site.contact.email,
      telephone: site.contact.phone,
      logo: `${site.url}/favicon.svg`,
      address: {
        "@type": "PostalAddress",
        streetAddress: site.address.street,
        addressLocality: site.address.city,
        addressRegion: site.address.region,
        postalCode: site.address.postalCode,
        addressCountry: site.address.countryCode,
      },
      sameAs: [site.social.linkedin, site.social.github, site.social.x],
    },
    {
      "@type": "ProfessionalService",
      "@id": `${site.url}/#service`,
      name: site.legalName,
      image: `${site.url}/og-image.svg`,
      url: site.url,
      description,
      priceRange: "$$$",
      telephone: site.contact.phone,
      email: site.contact.email,
      address: {
        "@type": "PostalAddress",
        streetAddress: site.address.street,
        addressLocality: site.address.city,
        addressRegion: site.address.region,
        postalCode: site.address.postalCode,
        addressCountry: site.address.countryCode,
      },
      areaServed: "Worldwide",
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Services",
        itemListElement: services.map((svc) => {
          const s = localizeService(svc, lang);
          return {
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: s.title,
              description: s.summary,
              url: `${site.url}${localizeHref(`/services/${s.slug}/`, lang)}`,
            },
          };
        }),
      },
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: site.url,
      name: site.name,
      publisher: { "@id": `${site.url}/#organization` },
      inLanguage,
    },
  ],
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(graph)}
/>
