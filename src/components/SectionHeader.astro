---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}
const {
  eyebrow,
  title,
  description,
  align = "left",
  class: className = "",
} = Astro.props;

const alignCls =
  align === "center" ? "text-center items-center mx-auto" : "text-left items-start";
---

<div class={`flex flex-col gap-4 ${alignCls} ${align === "center" ? "max-w-2xl" : "max-w-3xl"} ${className}`}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 class="text-3xl sm:text-4xl md:text-[2.6rem] font-bold leading-[1.1]">
    <Fragment set:html={title} />
  </h2>
  {
    description && (
      <p class="text-lg text-fg-muted leading-relaxed">{description}</p>
    )
  }
</div>
