---
/**
 * ZeeSpires logo. Two variants are rendered and CSS shows the right one for the
 * active page theme: the white wordmark on dark pages, the dark wordmark on
 * light (service) pages.
 */
interface Props {
  class?: string;
  height?: number;
}
const { class: className = "", height = 30 } = Astro.props;
---

<a
  href="/"
  class={`inline-flex items-center ${className}`}
  aria-label="ZeeSpires — home"
>
  <img
    src="/zeespires-logo.png"
    alt="ZeeSpires"
    height={height}
    style={`height:${height}px`}
    class="logo-on-dark w-auto select-none"
    decoding="async"
  />
  <img
    src="/zeespires-logo-dark.png"
    alt="ZeeSpires"
    height={height}
    style={`height:${height}px`}
    class="logo-on-light w-auto select-none"
    decoding="async"
  />
</a>

<style>
  /* Default (dark theme): show white logo. */
  :global(:root:not([data-theme="light"])) .logo-on-light {
    display: none;
  }
  :global(:root[data-theme="light"]) .logo-on-dark {
    display: none;
  }
</style>
