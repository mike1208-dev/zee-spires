---
import { site } from "@/data/site";
import { defaultLocale, locales, ogLocales } from "@/i18n/config";
import {
  translatedRoutes,
  stripLocale,
  useTranslations,
  resolveLocale,
} from "@/i18n/utils";
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import "@fontsource/noto-sans-jp/400.css";
import "@fontsource/noto-sans-jp/500.css";
import "@fontsource/noto-sans-jp/700.css";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Path to an OG image relative to site root, or absolute URL. */
  image?: string;
  /** Set true on pages that should not be indexed. */
  noindex?: boolean;
}

const lang = resolveLocale(Astro.currentLocale);
const t = useTranslations(lang);

const {
  title,
  description = t("meta.description"),
  image = "/og-image.svg",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const tagline = lang === defaultLocale ? site.tagline : t("meta.tagline");
const fullTitle =
  title === site.name ? `${site.name} — ${tagline}` : `${title} · ${site.name}`;

// Only emit hreflang alternates for routes that actually have a page in
// every locale (see translatedRoutes) — anything else stays untranslated.
const { path } = stripLocale(Astro.url.pathname);
const alternates = translatedRoutes[path];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{
  alternates && (
    <>
      {locales.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(alternates[l], site.url).href}
        />
      ))}
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(alternates[defaultLocale], site.url).href}
      />
    </>
  )
}

<meta name="theme-color" content={site.themeColor} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.legalName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocales[lang]} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
