---
import Icon from "./Icon.astro";

interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  class?: string;
  arrow?: boolean;
  type?: "button" | "submit";
  external?: boolean;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  arrow = false,
  type = "button",
  external = false,
} = Astro.props;

const base =
  "group inline-flex items-center justify-center gap-2 font-semibold rounded-full transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:opacity-60 disabled:pointer-events-none";

const sizes = {
  md: "text-sm px-5 py-2.5",
  lg: "text-base px-7 py-3.5",
};

const variants = {
  primary:
    "bg-accent text-accent-fg hover:bg-accent-hover shadow-sm hover:shadow-md hover:-translate-y-0.5",
  secondary:
    "bg-surface text-fg border border-border-strong hover:border-accent hover:text-accent",
  ghost: "text-fg hover:text-accent",
};

const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

{
  href ? (
    <a href={href} class={cls} rel={rel} target={target}>
      <slot />
      {arrow && (
        <Icon
          name="arrow"
          size={18}
          class="transition-transform duration-200 group-hover:translate-x-1"
        />
      )}
    </a>
  ) : (
    <button type={type} class={cls}>
      <slot />
      {arrow && (
        <Icon
          name="arrow"
          size={18}
          class="transition-transform duration-200 group-hover:translate-x-1"
        />
      )}
    </button>
  )
}
