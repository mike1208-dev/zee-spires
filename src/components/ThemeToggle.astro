---
import Icon from "./Icon.astro";
---

<button
  id="theme-toggle"
  type="button"
  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-fg-muted transition-colors hover:border-accent hover:text-accent"
  aria-label="Toggle color theme"
>
  <Icon name="sun" size={19} class="hidden dark-hidden" />
  <Icon name="moon" size={19} class="light-hidden" />
</button>

<style>
  /* Show the correct icon for the active theme. */
  :global(html:not([data-theme="dark"])) .light-hidden {
    display: none;
  }
  :global(html[data-theme="dark"]) .dark-hidden {
    display: none;
  }
  :global(html:not([data-theme="dark"])) .dark-hidden {
    display: inline-block;
  }
</style>

<script>
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const root = document.documentElement;
    const next =
      root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
</script>
