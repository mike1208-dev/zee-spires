---
import type { Service } from "@/data/services";
import Icon from "./Icon.astro";
import { resolveLocale, useTranslations, localizeHref } from "@/i18n/utils";

interface Props {
  service: Service;
  index?: number;
}
const { service, index = 0 } = Astro.props;
const num = String(index + 1).padStart(2, "0");
const lang = resolveLocale(Astro.currentLocale);
const url = localizeHref(`/services/${service.slug}/`, lang);
const t = useTranslations(lang);
---

<a
  href={url}
  class="card reveal group relative flex flex-col gap-4 p-7 transition-colors duration-300 hover:border-accent/30"
  data-delay={index * 80}
>
  <div class="flex items-center justify-between">
    <div
      class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent-hover transition-colors group-hover:bg-accent group-hover:text-accent-fg"
    >
      <Icon name={service.icon} size={24} />
    </div>
    <span
      class="text-sm font-medium text-fg-subtle"
      style="font-family: var(--font-display)">{num}</span>
  </div>
  <div class="mt-2 flex flex-col gap-2">
    <h3 class="text-xl font-semibold">{service.title}</h3>
    <p class="text-sm font-medium text-accent-hover">{service.tagline}</p>
  </div>
  <p class="text-[0.95rem] leading-relaxed text-fg-muted">{service.summary}</p>
  <span
    class="mt-auto inline-flex items-center gap-1.5 pt-3 text-sm font-semibold text-fg transition-colors group-hover:text-accent-hover"
  >
    {t("service.learnMore")}
    <Icon
      name="arrow"
      size={16}
      class="transition-transform duration-200 group-hover:translate-x-1"
    />
  </span>
</a>
