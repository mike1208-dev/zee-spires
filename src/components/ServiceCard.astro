---
import type { Service } from "@/data/services";
import Icon from "./Icon.astro";

interface Props {
  service: Service;
  href?: string;
  index?: number;
}
const { service, href = "/services/", index = 0 } = Astro.props;
---

<a
  href={`${href}#${service.slug}`}
  class="reveal group relative flex flex-col gap-4 rounded-2xl border border-border bg-surface p-7 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-[var(--shadow-card)]"
  data-delay={index * 80}
>
  <div
    class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent transition-colors group-hover:bg-accent group-hover:text-accent-fg"
  >
    <Icon name={service.icon} size={24} />
  </div>
  <div class="flex flex-col gap-2">
    <h3 class="text-xl font-bold">{service.title}</h3>
    <p class="text-sm font-medium text-accent">{service.tagline}</p>
  </div>
  <p class="text-[0.95rem] leading-relaxed text-fg-muted">{service.summary}</p>
  <span
    class="mt-auto inline-flex items-center gap-1.5 pt-2 text-sm font-semibold text-fg transition-colors group-hover:text-accent"
  >
    Learn more
    <Icon
      name="arrow"
      size={16}
      class="transition-transform duration-200 group-hover:translate-x-1"
    />
  </span>
</a>
