---
/**
 * 404 page body, shared by src/pages/404.astro (en) and
 * src/pages/ja/404.astro (ja).
 */
import Button from "@/components/Button.astro";
import { resolveLocale, useTranslations, localizeHref } from "@/i18n/utils";

const lang = resolveLocale(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
  <p class="text-7xl font-bold text-accent sm:text-8xl">404</p>
  <h1 class="mt-4 text-2xl font-bold sm:text-3xl">
    <Fragment set:html={t("notFound.heading")} />
  </h1>
  <p class="mt-3 max-w-md text-fg-muted">
    {t("notFound.description")}
  </p>
  <div class="mt-8 flex flex-col gap-3 sm:flex-row">
    <Button href={localizeHref("/", lang)} size="lg" arrow>{t("notFound.backHome")}</Button>
    <Button href={localizeHref("/contact/", lang)} variant="secondary" size="lg">
      {t("notFound.contactUs")}
    </Button>
  </div>
</section>
