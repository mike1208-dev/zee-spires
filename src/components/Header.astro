---
import { nav } from "@/data/site";
import Logo from "./Logo.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { locales, localeNames } from "@/i18n/config";
import {
  resolveLocale,
  useTranslations,
  getAlternateUrl,
  localizeHref,
} from "@/i18n/utils";

const path = Astro.url.pathname;
const lang = resolveLocale(Astro.currentLocale);
const t = useTranslations(lang);

// Nav hrefs are canonical English paths; rewrite to this locale's equivalent
// (falls through unchanged for routes with no translation yet).
const href = (h: string) => localizeHref(h, lang);
const homeHref = href("/");
const isActive = (h: string) => {
  const target = href(h);
  return target === homeHref ? path === target : path.startsWith(target);
};
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent transition-all duration-300"
>
  <div class="container-page">
    <div class="flex h-18 items-center justify-between gap-4">
      <Logo height={56} />

      <!-- Desktop nav (flat) -->
      <nav class="hidden items-center gap-1 lg:flex" aria-label={t("nav.ariaPrimary")}>
        {
          nav.map((item) =>
            item.children ? (
              <div class="group relative">
                <button
                  type="button"
                  aria-haspopup="true"
                  class:list={[
                    "inline-flex cursor-default items-center gap-1 px-3.5 py-2 text-sm font-medium transition-colors",
                    isActive(item.href)
                      ? "text-accent-hover"
                      : "text-fg group-hover:text-accent-hover",
                  ]}
                >
                  {t(item.labelKey)}
                  <Icon
                    name="chevron"
                    size={15}
                    class="transition-transform duration-200 group-hover:rotate-180"
                  />
                </button>
                {/* Dropdown */}
                <div class="invisible absolute left-0 top-full pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                  <div class="card w-72 p-2 shadow-[var(--shadow-float)]">
                    {item.children.map((c) => (
                      <a
                        href={href(c.href)}
                        aria-current={
                          path === href(c.href) ||
                          (href(c.href) !== href("/services/") &&
                            path.startsWith(href(c.href)))
                            ? "page"
                            : undefined
                        }
                        class="block rounded-lg px-3 py-2.5 text-sm font-medium text-fg-muted transition-colors hover:bg-accent-soft hover:text-accent-hover"
                      >
                        {t(c.labelKey)}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={href(item.href)}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "px-3.5 py-2 text-sm font-medium transition-colors",
                  isActive(item.href)
                    ? "text-accent-hover"
                    : "text-fg hover:text-accent-hover",
                ]}
              >
                {t(item.labelKey)}
              </a>
            )
          )
        }
      </nav>

      <div class="flex items-center gap-3">
        <!-- Language switcher -->
        <div
          class="hidden items-center whitespace-nowrap rounded-full border border-border-strong bg-fg/5 p-1 backdrop-blur-sm sm:flex"
          aria-label={t("lang.switchAria")}
        >
          {
            locales.map((l) =>
              l === lang ? (
                <span
                  class="rounded-full bg-accent-soft px-3 py-1 text-sm font-semibold text-accent-hover"
                  aria-current="true"
                >
                  {localeNames[l]}
                </span>
              ) : (
                <a
                  href={getAlternateUrl(path, l)}
                  class="rounded-full px-3 py-1 text-sm font-medium text-fg-muted transition-colors hover:text-fg"
                >
                  {localeNames[l]}
                </a>
              )
            )
          }
        </div>
        <div class="hidden sm:block">
          <Button href={href("/contact/")} size="md" arrow>{t("cta.startProject")}</Button>
        </div>
        <button
          id="menu-open"
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border text-fg lg:hidden"
          aria-label={t("nav.openMenu")}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" size={20} />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 hidden overflow-y-auto bg-bg/95 backdrop-blur-md lg:hidden"
  >
    <div class="container-page">
      <div class="flex h-18 items-center justify-between">
        <Logo height={48} />
        <button
          id="menu-close"
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border text-fg"
          aria-label={t("nav.closeMenu")}
        >
          <Icon name="close" size={20} />
        </button>
      </div>
      <nav class="mt-6 flex flex-col gap-1 pb-10" aria-label={t("nav.ariaMobile")}>
        {
          nav.map((item) =>
            item.children ? (
              <Fragment>
                <p class="px-4 pb-1 pt-3 text-xs font-semibold uppercase tracking-widest text-fg-subtle">
                  {t(item.labelKey)}
                </p>
                <div class="ml-3 flex flex-col gap-0.5 border-l border-border pl-4">
                  {item.children.map((c) => (
                    <a
                      href={href(c.href)}
                      class="rounded-lg px-3 py-2.5 text-base text-fg-muted transition-colors hover:text-accent-hover"
                    >
                      {t(c.labelKey)}
                    </a>
                  ))}
                </div>
              </Fragment>
            ) : (
              <a
                href={href(item.href)}
                class:list={[
                  "rounded-xl px-4 py-3.5 text-lg font-medium transition-colors",
                  isActive(item.href)
                    ? "bg-surface text-accent-hover"
                    : "text-fg hover:bg-surface",
                ]}
              >
                {t(item.labelKey)}
              </a>
            )
          )
        }
        <div
          class="mt-3 inline-flex items-center self-start whitespace-nowrap rounded-full border border-border-strong bg-fg/5 p-1"
          aria-label={t("lang.switchAria")}
        >
          {
            locales.map((l) =>
              l === lang ? (
                <span
                  class="rounded-full bg-accent-soft px-4 py-1.5 text-base font-semibold text-accent-hover"
                  aria-current="true"
                >
                  {localeNames[l]}
                </span>
              ) : (
                <a
                  href={getAlternateUrl(path, l)}
                  class="rounded-full px-4 py-1.5 text-base font-medium text-fg-muted transition-colors hover:text-fg"
                >
                  {localeNames[l]}
                </a>
              )
            )
          }
        </div>
        <div class="mt-4">
          <Button href={href("/contact/")} size="lg" arrow class="w-full">
            {t("cta.startProject")}
          </Button>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const onScroll = () => {
    const on = window.scrollY > 8;
    header?.classList.toggle("bg-bg/80", on);
    header?.classList.toggle("backdrop-blur-xl", on);
    header?.classList.toggle("border-border", on);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const menu = document.getElementById("mobile-menu");
  const openBtn = document.getElementById("menu-open");
  const closeBtn = document.getElementById("menu-close");
  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    openBtn?.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  };
  openBtn?.addEventListener("click", () => setOpen(true));
  closeBtn?.addEventListener("click", () => setOpen(false));
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setOpen(false))
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>
