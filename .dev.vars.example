# Copy to `.dev.vars` for local development with `wrangler pages dev`,
# and set the same keys in the Cloudflare Pages dashboard for production
# (Settings → Environment variables).
#
# Used by functions/api/contact.ts to send inquiry emails via Resend.

RESEND_API_KEY="re_your_api_key_here"
CONTACT_TO="admin@zeespires.com"
CONTACT_FROM="ZeeSpires Website <website@zeespires.com>"
